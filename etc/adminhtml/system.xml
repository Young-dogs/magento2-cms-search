<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <tab id="youngdogs" translate="label" sortOrder="10" class="youngdogs-tab">
            <label>YOUNG-DOGS</label>
        </tab>
        <section id="yd_cms_search" translate="label" type="text" sortOrder="300" showInDefault="1" showInWebsite="1" showInStore="1">
            <class>separator-top</class>
            <label>CMS Search</label>
            <tab>youngdogs</tab>
            <resource>YoungDogs_CmsSearch::config</resource>
            <group id="branding" translate="label" type="text" sortOrder="0" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>CMS Search</label>
                <frontend_model>YoungDogs\CmsSearch\Block\Adminhtml\System\Config\Form\Fieldset\ModuleInformation</frontend_model>
            </group>
            <group id="general" translate="label" type="text" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>General</label>
                <field id="enabled" translate="label comment" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Enable module</label>
                    <comment>Enables the cmsPageSearch and cmsBlockSearch GraphQL queries.</comment>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="max_page_size" translate="label comment" type="text" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Maximum Page Size</label>
                    <comment>Maximum number of items a single search request can return, regardless of the requested pageSize.</comment>
                    <validate>validate-digits validate-greater-than-zero</validate>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>
            </group>
        </section>
    </system>
</config>
