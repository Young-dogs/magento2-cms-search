{
    "name": "youngdogs/magento2-cms-search",
    "description": "Adds flexible GraphQL search for CMS pages and CMS blocks (search by content, title, content_heading, and more, with word and exact-phrase matching).",
    "version": "1.1.0",
    "type": "magento2-module",
    "license": "MIT",
    "authors": [
        {
            "name": "YoungDogs"
        }
    ],
    "require": {
        "php": ">=8.2 <8.6",
        "magento/module-cms": ">=104.0 <107",
        "magento/module-store": ">=101.1 <103",
        "magento/module-graph-ql": ">=100.4 <102"
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "YoungDogs\\CmsSearch\\": ""
        }
    }
}
